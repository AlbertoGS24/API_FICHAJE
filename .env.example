DATABASE_URL="postgresql://fichar:fichar@localhost:5432/fichar"

# Firebase Web API Key usada por el frontend para login.
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Onboarding de nuevas empresas
PUBLIC_COMPANY_SELF_REGISTER_ENABLED="false"
PUBLIC_DEV_TOOLS_ENABLED="false"
CORS_ORIGIN_ALLOWLIST="https://tu-dominio.com"
RATE_LIMIT_GLOBAL_MAX="180"
RATE_LIMIT_ONBOARDING_MAX="12"
RATE_LIMIT_AGENT_MAX="60"
ALLOW_DEFAULT_COMPANY_BOOTSTRAP="false"

# Turnstile CAPTCHA (Cloudflare) para onboarding público.
# En local puedes dejarlo en false.
TURNSTILE_ENABLED="false"
TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

# Backups automáticos de base de datos
AUTO_BACKUP_ENABLED="true"
AUTO_BACKUP_INTERVAL_HOURS="24"
BACKUP_RETENTION_DAYS="30"
# BACKUP_DIR="backups"

# Notificaciones por email (SMTP)
MAIL_ENABLED="false"
MAIL_FROM="your-account@gmail.com"
MAIL_FROM_NAME="Fichaje"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-account@gmail.com"
SMTP_PASS="YOUR_SMTP_PASSWORD_OR_APP_PASSWORD"

# Geolocalización y dirección legible en fichajes
GEO_REVERSE_GEOCODE_ENABLED="true"
GEO_REVERSE_GEOCODE_URL="https://nominatim.openstreetmap.org/reverse"

# Valores por defecto RRHH
DEFAULT_VACATION_ALLOWANCE_DAYS="22"

# Integración OpenClaw / agente externo.
# El interruptor global permanece en .env, pero los tokens se generan por empresa
# y se guardan hasheados en base de datos.
OPENCLAW_ENABLED="false"
# npm run issue:openclaw-token -- --company-code DEFAULT
